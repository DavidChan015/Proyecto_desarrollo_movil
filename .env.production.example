NODE_ENV=production
PORT=3000

# Configure these with the RDS endpoint and application database credentials.
DB_HOST=your-rds-endpoint
DB_PORT=5432
DB_NAME=your_database
DB_USER=your_app_user
DB_PASSWORD=replace-with-a-strong-database-password
DB_CREATE_IF_MISSING=false

# Generate a unique random value of at least 32 characters and keep it stable.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# The EC2 instance role supplies AWS credentials; do not set AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, or AWS_PROFILE in this production file.
AWS_REGION=us-east-1

# Native Android clients do not require CORS. Set an origin only if a web client needs it.
CORS_ORIGIN=
