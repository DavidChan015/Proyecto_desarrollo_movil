DB_HOST=localhost
DB_PORT=5433
DB_USER=admin
DB_PASSWORD=change-me
DB_NAME=mydb
DB_CREATE_IF_MISSING=true

# Generate a private random value with at least 32 characters.
JWT_SECRET=replace-with-a-private-random-secret-of-at-least-32-characters
PORT=3000
CORS_ORIGIN=http://localhost:4200

# Local AWS SDK credentials (use an AWS CLI profile, never access keys here).
AWS_REGION=us-east-1
AWS_PROFILE=mi-perfil-aws
